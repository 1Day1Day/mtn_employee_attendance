# Supabase pooled connection string (use the "Transaction" pooler on port 6543 for Vercel)
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?pgbouncer=true"
# Supabase direct connection string (used only for migrations)
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# Random long string used to sign session cookies and daily QR tokens
JWT_SECRET="replace-with-a-long-random-string"

# The public URL of the deployed app, used to build the QR code link
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Station device: a fixed value this one device sends with every request so
# the server knows the clock-in came from the registered branch station.
# Deploy the station page as its own Vercel project/build with these two set
# to the SAME value, so the secret isn't baked into the staff-facing build.
STATION_DEVICE_SECRET="replace-with-a-long-random-string"
NEXT_PUBLIC_STATION_DEVICE_SECRET="replace-with-a-long-random-string"
